# ── Bhoomi Setu — environment variables ──────────────────────────────────────
# Copy to `.env` (gitignored) and adjust. Backend values can also live in
# `server/.env.example` → `server/.env`; the server reads both locations.

# ── Backend (Fastify API) ────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (server-side only).
DATABASE_URL=postgresql://bhoomi:bhoomi2026@127.0.0.1:5432/bhoomisetu

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase project — server side only, never shipped to the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# dev-header = resolve actor from x-actor-id header, role/organization/
# jurisdiction always loaded server-side from the `users` table.
AUTH_MODE=development-header

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Vite only exposes VITE_* variables to the browser — never put service-role
# keys or database credentials here.
VITE_API_BASE_URL=http://localhost:4000
# Temporary development actor id (seeded national admin). Real login replaces this.
VITE_DEV_ACTOR_ID=00000000-0000-4000-8000-000000000201
