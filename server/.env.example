# ── Bhoomi Setu — backend environment (Fastify + PostgreSQL/PostGIS) ─────────
# Copy to server/.env and fill in real values. NEVER commit server/.env.

# PostgreSQL connection string for the Supabase project database.
# Local development (docker container `bhoomi-setu-db`):
DATABASE_URL=postgresql://bhoomi:bhoomi2026@127.0.0.1:5432/bhoomisetu
# Supabase project (server-side only — use the pooled connection string from
# Supabase Dashboard → Settings → Database):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0.<region>.pooler.supabase.com:6543/postgres

# API server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase project credentials — SERVER SIDE ONLY, never expose to the browser.
# Reserved for the upcoming Supabase Auth + Storage work; unused for now.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication boundary.
#   development-header → actor resolved from the `x-actor-id` header, with the
#                        role/organization/jurisdiction loaded from the DB.
#   disabled           → no actor; write endpoints return 401, reads stay open.
AUTH_MODE=development-header
